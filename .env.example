# Configuration for web scraping
# NOTE: This is a demonstration version using simulated data.
# For production use, you'll need real API credentials.

# Instagram credentials (optional - not used in demo version)
# WARNING: Storing passwords in .env is not secure for production
# Consider using Instagram Graph API instead
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Google Custom Search API (optional - not used in demo version)
# Get your API key from: https://developers.google.com/custom-search
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Output configuration
OUTPUT_FORMAT=csv          # Options: csv or json
MAX_RESULTS_PER_PLATFORM=50
